# ==========================================================================
# PhishTrace secrets. Copy to .env (chmod 600) and fill only what you have.
# A missing key is never an error: that provider is skipped and logged.
# SECURITY: this file is git-ignored except for this example.
# ==========================================================================

# --- web session (required for non-loopback binds) -------------------------
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
PHISHTRACE_SESSION_SECRET=

# --- optional runtime overrides --------------------------------------------
# PHISHTRACE_HOST=127.0.0.1
# PHISHTRACE_PORT=8088
# PHISHTRACE_DATA_DIR=data
# PHISHTRACE_AUTH_ENABLED=true

# --- Phase A (free keys) ---------------------------------------------------
# PhishTank free API key: https://www.phishtank.com/api_register.php
PHISHTANK_API_KEY=

# abuse.ch Auth-Key (free account) - enables URLhaus and ThreatFox
# https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Reddit "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=phishtrace/1.0 (security research)

# Mastodon access token is optional; public search works without it on many instances
MASTODON_TOKEN=
# Comma separated instances (defaults to mastodon.social,infosec.exchange,mstdn.social)
MASTODON_INSTANCES=

# Bluesky public API needs no key. Optional app password for higher limits:
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Threat intelligence / attack surface ---------------------------------
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
# Censys retired the legacy Search API v2 on 2026-09-30.  A Personal Access
# Token (censys_...) unlocks the free per-asset host lookup used by the
# censys provider; Platform *search* additionally needs a paid org ID.
CENSYS_API_TOKEN=
SECURITYTRAILS_API_KEY=
WHOISXML_API_KEY=
DOMAINTOOLS_API_KEY=
DOMAINTOOLS_USERNAME=
VALIDIN_API_KEY=
SILENTPUSH_API_KEY=
NETLAS_API_KEY=
CRIMINALIP_API_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_API_KEY=
HYBRID_ANALYSIS_API_KEY=
MALWAREBAZAAR_API_KEY=
MDTI_TOKEN=
INTELX_API_KEY=
HUDSONROCK_API_KEY=
DEHASHED_API_KEY=
DEHASHED_EMAIL=

# --- Social / search -------------------------------------------------------
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
SERPAPI_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Optional Telegram bot token used only to READ public channel previews (never posted to)
TELEGRAM_BOT_TOKEN=

# --- SpiderFoot ------------------------------------------------------------
SPIDERFOOT_API_KEY=

# --- Optional push integrations -------------------------------------------
OPENCTI_URL=
OPENCTI_TOKEN=
MISP_URL=
MISP_KEY=
MISP_VERIFY_TLS=true
