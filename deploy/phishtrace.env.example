# /etc/phishtrace/phishtrace.env
# Install with: install -o root -g phishtrace -m 0640 deploy/phishtrace.env.example /etc/phishtrace/phishtrace.env
# Never commit the filled-in file.

# Bind loopback and publish through a TLS reverse proxy. Binding a public
# interface directly is refused unless auth and a strong session secret are set.
PHISHTRACE_HOST=127.0.0.1
PHISHTRACE_PORT=8088
PHISHTRACE_DATA_DIR=/var/lib/phishtrace

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PHISHTRACE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional provider credentials. Leave unset to keep a provider in "skipped".
# OTX_API_KEY=
# VIRUSTOTAL_API_KEY=
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# SECURITYTRAILS_API_KEY=
# WHOISXML_API_KEY=
# GREYNOISE_API_KEY=
# ABUSEIPDB_API_KEY=
# HYBRID_ANALYSIS_API_KEY=
# MALWAREBAZAAR_API_KEY=
# PHISHTANK_API_KEY=
# ABUSECH_AUTH_KEY=
# HUDSONROCK_API_KEY=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Optional export integrations (enable them in config.yaml first).
# OPENCTI_TOKEN=
# MISP_API_KEY=
